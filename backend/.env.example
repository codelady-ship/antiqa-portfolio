MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/portfolio
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_EMAIL=you@example.com
# npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# "Forgot password?" on the admin sign-in page: Resend API key (resend.com -> API Keys, "Sending access").
# Without it the reset flow sends nothing. The mail always goes to ADMIN_EMAIL.
RESEND_API_KEY=
# optional: sender, once a domain is verified in Resend (default: Antiqa Portfolio <onboarding@resend.dev>)
MAIL_FROM=
# optional: the site address used in the reset link (default https://antiqa-portfolio.vercel.app; only the site's own addresses are accepted)
SITE_URL=
# optional: fine-grained token, public repos read-only (raises GitHub limit 60 -> 5000/h)
GITHUB_TOKEN=
# optional: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
PORT=4000
