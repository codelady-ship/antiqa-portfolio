MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/portfolio
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_EMAIL=you@example.com
# npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# optional: fine-grained token, public repos read-only (raises GitHub limit 60 -> 5000/h)
GITHUB_TOKEN=
# optional: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
PORT=4000
